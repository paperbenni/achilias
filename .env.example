# Users can enter public HTTPS ILIAS addresses by default.
# Set true for a curated list (Freiburg is always enabled).
# ACHILIAS_RESTRICT_INSTANCES=true
# Additional installations when restriction is enabled.
# ILIAS_INSTANCES=https://ilias.example.edu/ilias/

# ACHILIAS_DATA_DIR=/absolute/path/to/private/achilias-data
# ACHILIAS_ORIGIN=http://127.0.0.1:3000
# ACHILIAS_SECURE_COOKIE=true
# ACHILIAS_BROWSER_PATH=/usr/bin/chromium

# auto chooses the laptop helper on Linux without DISPLAY/WAYLAND_DISPLAY.
# Set remote explicitly for a headless server; no server Chromium is needed.
# ACHILIAS_LOGIN_MODE=remote

# Live mutations are OFF unless the exact canonical object URL is listed.
# Start with disposable test objects; see docs/live-testing.md.
# ACHILIAS_WRITE_TARGETS=https://ilias.uni-freiburg.de/goto.php?target=exc_12345

# For a PUBLIC deployment set the exact HTTPS app origin and use remote login.
# ACHILIAS_ORIGIN=https://learn.example.org
# Enable only behind a proxy that OVERWRITES X-Forwarded-For; see docs/deployment.md.
# ACHILIAS_TRUST_PROXY=true

# ACHILIAS_DATA_DIR=/absolute/path/to/private/achilias-data
# Achilias app origin for origin checks and secure cookies. This is NOT the
# ILIAS instance; users choose that in the connection dialog.
# ACHILIAS_ORIGIN=http://127.0.0.1:3000
# ACHILIAS_SECURE_COOKIE=true

# The server never launches a browser. Users choose their ILIAS instance and
# sign in with the password form, the laptop helper, or existing cookies.

# Live mutations are OFF unless the exact canonical object URL is listed.
# Start with disposable test objects; see docs/live-testing.md.
# ACHILIAS_WRITE_TARGETS=https://ilias.uni-freiburg.de/goto.php?target=exc_12345

# Password sign-in is on by default. Set false on a shared or public deployment.
# The server receives the password in memory and submits your university's real
# login form; it never stores it.
# ACHILIAS_PASSWORD_LOGIN=false

# For a public deployment set the exact HTTPS app origin.
# ACHILIAS_ORIGIN=https://learn.example.org
# Enable only behind a proxy that OVERWRITES X-Forwarded-For; see docs/deployment.md.
# ACHILIAS_TRUST_PROXY=true

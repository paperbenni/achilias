{
  "name": "achilias",
  "version": "0.1.3",
  "description": "A calmer frontend for ILIAS, with a local production server and a laptop sign-in helper.",
  "bin": {
    "achilias": "bin/achilias.mjs"
  },
  "files": [
    "bin/achilias.mjs",
    "bin/cli.mjs",
    "standalone/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint",
    "test": "bun test tests",
    "typecheck": "tsc --noEmit",
    "browser:install": "playwright install chromium",
    "connect": "bun scripts/connect.mts",
    "build:standalone": "bun scripts/build-standalone.ts",
    "package:standalone": "bun scripts/package-standalone.ts",
    "release:prepare": "bun scripts/prepare-release.mts",
    "test:package": "bun scripts/test-package.mts",
    "prepublishOnly": "bun run release:prepare",
    "test:e2e": "bun scripts/smoke.ts && bun scripts/forum-smoke.ts && bun scripts/headless-smoke.ts && bun scripts/exercise-smoke.ts && bun scripts/multi-user-smoke.ts && bun scripts/form-serialization-smoke.ts && bun scripts/pdf-theme-smoke.ts && bun scripts/card-actions-smoke.ts && bun scripts/compatibility-smoke.ts && bun scripts/mobile-smoke.ts",
    "test:compatibility": "bun scripts/compatibility-smoke.ts",
    "screenshots": "bun scripts/screenshots.ts",
    "test:forums": "bun scripts/forum-smoke.ts",
    "test:mobile": "bun scripts/mobile-smoke.ts",
    "test:pwa": "bun scripts/pwa-smoke.ts",
    "icons:generate": "bun scripts/generate-app-icons.ts",
    "test:headless": "bun scripts/headless-smoke.ts",
    "benchmark:navigation": "bun scripts/navigation-benchmark.ts",
    "test:navigation": "bun scripts/navigation-smoke.ts",
    "test:exercises": "bun scripts/exercise-smoke.ts",
    "test:multi-user": "bun scripts/multi-user-smoke.ts",
    "test:forms": "bun scripts/form-serialization-smoke.ts",
    "test:search": "bun scripts/search-smoke.ts && bun scripts/search-discovery-smoke.ts",
    "test:search-prefetch": "bun scripts/search-prefetch-smoke.ts",
    "test:pdf-theme": "bun scripts/pdf-theme-smoke.ts",
    "test:cards": "bun scripts/card-actions-smoke.ts"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "commander": "^15.1.0",
    "env-paths": "^4.0.0",
    "execa": "^10.2.1",
    "get-port": "^7.2.0",
    "ipaddr.js": "^2.5.0",
    "open": "^11.0.4",
    "playwright-core": "1.64.1",
    "tough-cookie": "^6.0.2",
    "undici": "^8.12.3",
    "wait-on": "^9.5.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/bun": "^1.4.4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "agentation": "^3.1.2",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "content-disposition": "^3.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "lucide-react": "^1.66.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "playwright": "1.64.1",
    "radix-ui": "^1.8.1",
    "rate-limiter-flexible": "^11.2.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "^2.18.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "zod": "^4.6.7"
  },
  "packageManager": "bun@1.4.4",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "engines": {
    "node": ">=22.19.0"
  }
}
